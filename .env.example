# ---------------------------------------------------------------------------
# Example environment file for local development and deployment.
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`.
# The real `.env` is git-ignored; this template contains placeholders only.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DEBUG=True

# --- Database: choose ONE profile -----------------------------------------
# DATABASE_PROFILE=local uses the DB_* block; DATABASE_PROFILE=neon uses PG_*.
DATABASE_PROFILE=local

# Local PostgreSQL (DATABASE_PROFILE=local)
DB_NAME=schoolsystem_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Neon PostgreSQL (DATABASE_PROFILE=neon).
# Use the DIRECT (non-pooler) host: schema-per-tenant isolation depends on a
# session-level search_path, which Neon's transaction-mode pooler does not keep.
PGHOST=ep-xxxxxxxxxxxx.eu-central-1.aws.neon.tech
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=replace-me
PGPORT=5432
PGSSLMODE=require

# --- Multi-tenancy ---------------------------------------------------------
TENANCY_ENABLED=False
PLATFORM_ADMIN_DOMAIN=

# Host allow-list and CSRF origins.
# While TENANCY_ENABLED=True, ALLOWED_HOSTS is ignored (forced to '*') and
# tenant hostnames are validated against the Domain table instead.
# While TENANCY_ENABLED=False, every hostname the site answers on — including
# PUBLIC_WEBSITE_DOMAIN below — must be listed here or requests are rejected.
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# --- Media storage: filesystem (dev) or neon_s3 (durable staging/prod) -----
MEDIA_STORAGE_BACKEND=filesystem
# Required only when MEDIA_STORAGE_BACKEND=neon_s3
NEON_STORAGE_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Email -----------------------------------------------------------------
# Console backend prints messages to the logs and never sends real mail.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- SMS (keep False for staging to avoid real messages) -------------------
SMS_ENABLED=False
SMS_ONLINE_GH_API_KEY=
SMS_SENDER_ID=ATSEC

# --- Celery / Redis --------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# --- Rate limiting & cache -------------------------------------------------
# LocMemCache is per-process; point at a shared backend for multi-worker limits.
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=schoolsystem-cache
TRUSTED_PROXY_COUNT=1
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=300
PUBLIC_REPORT_RATE_LIMIT=5
PUBLIC_REPORT_RATE_WINDOW=3600

# Student ID QR token lifetime in days (0 = never expire).
STUDENT_ID_PUBLIC_TOKEN_TTL_DAYS=0

# --- Public website: Eden Creative Systems marketing site ------------------
# The public site for the SHS Boarding & Dorm Management System. It is served
# from a host that is deliberately NOT a school tenant, so ecreativesys.com
# must NEVER be added to the Domain table — doing so would present a school's
# dashboard at the marketing address.
#
# Hosts that serve the marketing site, comma-separated. Hostnames only: no
# scheme, no port, no path (a request's port is stripped before comparing).
# Leave empty to disable the bypass entirely.
#
# List the MAIN domain. Never list a school's hostname — the marketing site
# would shadow that school's own site, and the public pages never link to a
# school address anyway.
#   Local tenancy development: localhost,127.0.0.1
#   Staging and production:    ecreativesys.com
# Add www.ecreativesys.com only if that hostname is configured in DNS too.
# Canonical links still name the main domain, so crawlers are not split.
PUBLIC_WEBSITE_DOMAIN=

# Master switch for the public-website host bypass.
PUBLIC_WEBSITE_ENABLED=True

# URLconf applied on those hosts. Must stay pointed at the public URLconf;
# the school URLconf here would expose the application at the marketing domain.
PUBLIC_WEBSITE_URLCONF=schoolsystem.urls_public

# The site's own absolute origin, used for canonical URLs, Open Graph tags,
# the sitemap and the Sitemap: line in robots.txt.
#   Production: https://ecreativesys.com
# Empty falls back to https://EDEN_SYS_DOMAIN, and only then to the hostname of
# each request (local development and the /site/ preview).
SITE_URL=

# Where school staff sign in. The site never links to a school's hostname, so
# this is published only when it points at the site's own domain (SITE_URL /
# EDEN_SYS_DOMAIN). Anything else is dropped and reported by the website.W001
# system check. Left empty on purpose: the "Login" link is hidden until a real
# URL on the main domain is supplied, rather than pointing somewhere invented.
EDEN_PORTAL_LOGIN_URL=

# Published pricing is OFF until an approved price list exists. Turning this on
# has no effect while website/pricing.py APPROVED_PRICE_LIST is empty.
PRICING_PUBLIC_ENABLED=False

# Recipients for demonstration requests. Empty falls back to DEFAULT_FROM_EMAIL.
# Enquiries are always stored, even when email delivery fails.
DEMO_REQUEST_NOTIFY_EMAILS=

# Demonstration-request abuse limits, applied per client address.
DEMO_REQUEST_RATE_LIMIT=5
DEMO_REQUEST_RATE_WINDOW=3600
